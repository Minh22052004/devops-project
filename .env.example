# Copy this file to .env and adjust. NEVER commit .env (it is in .gitignore).
DB_USER=postgres
DB_PASSWORD=bugpassword
DB_NAME=bugdb

# Used to name images: <DOCKER_HUB_USERNAME>/bug-tracker-backend:<IMAGE_TAG>
DOCKER_HUB_USERNAME=local
IMAGE_TAG=latest

# Baked into the frontend bundle at build time (browser -> backend URL)
REACT_APP_API_URL=http://localhost:8080
